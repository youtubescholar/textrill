# Build output. 1.7 GB of cargo artifacts; the corpus runner also defaults
# MINE to target/debug/txt2html, so this path is load-bearing, not just noise.
txt2html-rs/target/

# The reference (Perl) checkout the differential harness compares against.
# Derived: `make ref` extracts the tracked txt2html-3.0.tar.gz into ref/ and
# copies the tracked stub at tests/refstub/YAML/Syck.pm into ref/stubs/. Both
# halves are reproducible offline, so nothing under ref/ is versioned. The
# canonical stub lives at tests/refstub/ precisely so its reasoning is
# reviewable -- a stub that exists only on one machine is how the gate became
# unreproducible in the first place.
ref/

# Virtualenv used to build the extension and run the GUI tests
# (maturin develop --release, python -m unittest).
.venv/

# Packaging droppings and the extension module maturin builds in place.
*.egg-info/
txt2html-rs/python/txt2html/_native*.so
# setuptools' staging dirs, left behind by `python -m build` on the GUI
# package. Untracked build output, not part of the sdist or wheel.
txt2html-gui/build/
txt2html-gui/dist/

# Python bytecode from the corpus runner and the fuzzer.
__pycache__/
*.pyc

# Editor and OS droppings.
*.swp
*~
.DS_Store
