[Desktop Entry]
Type=Application
Name=Textrill
GenericName=Text to HTML converter
Comment=Convert plain text into well-formed HTML
Exec=textrill-gui %f
TryExec=textrill-gui
Icon=io.github.youtubescholar.Textrill
Terminal=false
Categories=Utility;TextTools;
MimeType=text/plain;
Keywords=text;html;convert;markup;txt2html;
StartupNotify=true
StartupWMClass=textrill-gui
